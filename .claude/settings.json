{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/window.py *)",
      "Bash(python scripts/explore.py *)",
      "Bash(python scripts/context.py *)",
      "Bash(python scripts/ko.py *)",
      "Bash(python scripts/watch.py list)",
      "Bash(git pull)",
      "Bash(git pull --rebase)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ],
    "ask": [
      "Bash(python scripts/watch.py *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npx *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pip install *)",
      "Bash(claude mcp add *)",
      "Bash(claude plugin install *)",
      "Bash(git push --force *)",
      "Bash(git config --global *)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(//**/.env)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/guard_command.py"
          }
        ]
      }
    ]
  }
}
